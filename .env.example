# ══════════════════════════════════════════════════════════════
# Google Maps Lead Scraper Pro AI — Environment Variables
# ══════════════════════════════════════════════════════════════
#
# HOW TO USE:
# 1. Copy this file:  cp .env.example .env
# 2. Open .env and replace every YOUR_xxx with your real values
# 3. Save the file
# 4. Run: npm run build
# 5. Upload the "dist" folder to Hostinger
#
# ⚠️ NEVER share your .env file or commit it to git
# ══════════════════════════════════════════════════════════════

# ─── SUPABASE (Database + Auth) ───
# Get from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── GOOGLE OAUTH (Google Sign-In) ───
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0
# (You paste these into Supabase Dashboard → Auth → Google Provider)
# No env var needed here — Supabase handles it server-side

# ─── PAYUMONEY (Payments) ───
# Get from: https://www.payumoney.com → Dashboard → My Account
VITE_PAYU_MERCHANT_KEY=YOUR_PAYU_MERCHANT_KEY
VITE_PAYU_MODE=test
# NOTE: Merchant Salt goes ONLY in your backend (Supabase Edge Function)
# Never put Salt in frontend code

# ─── Plan Prices in INR ───
VITE_PRICE_PRO=2399
VITE_PRICE_AGENCY=8199
VITE_PRICE_ENTERPRISE=24799

# ─── RESEND (Email Sending) ───
# Get from: https://resend.com → API Keys
# NOTE: API key goes ONLY in backend (Supabase Edge Function)
# Frontend only needs the "from" email for display
VITE_EMAIL_FROM=noreply@yourdomain.com

# ─── GOOGLE PLACES API (Scraping) ───
# Get from: https://console.cloud.google.com → Credentials
# NOTE: In production, this key should be in backend only
# For now it works in frontend with HTTP referrer restrictions
VITE_GOOGLE_PLACES_KEY=YOUR_GOOGLE_PLACES_API_KEY

# ─── YOUR BUSINESS ───
VITE_ADMIN_EMAIL=owner@masteredge.tech
VITE_APP_URL=https://yourdomain.com
